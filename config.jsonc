

{
    "layer": "top",
    "position": "left",
    "mod": "dock",
  "margin-left": 0,
  "margin-right": -10,
  "margin-top": 0,
  "margin-bottom": 0,
    "exclusive": true,
    "passthrough": true,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["tray","network", "battery"],

  "tray": {
    "format": "{icon}",
    "padding": 10,
    "show-passive-items": false,
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
	"1": "一",
	"2": "二",
	"3": "三",
	"4": "四",
	"5": "五",
	"6": "六",
    	"7": "七",
    	"8": "八",
    	"9": "九",
    	"10": "十",
    }
  },
  

    "battery": {
      "interval": 60,
      "states": {
          "good": 95,
          "warning": 30,
          "critical": 20
      },
      "format": "{icon}",
      "rotate": 90,
      "format-charging": "-{icon}+",
      "format-plugged": "/{icon}/",
      "format-icons": ["", "|", "||", "|||", "||||", "|||||", "||||||", "|||||||", "||||||||", "|||||||||","||||||||||"],
},

    "network": {
        "rotate": 0,
        "format-wifi" : "无线",
        "format-ethernet": "线",
        "format-disconnected" : "!",
        "tooltip": false
    },
}
